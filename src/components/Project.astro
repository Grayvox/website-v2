---
import { Image } from 'astro:assets';
import { Icon } from "astro-icon/components";

import Card from "./Card.astro";

const { name, src, alt, itch, website, github } = Astro.props;
---
<style>
    [data-icon] {
        width: 48px;
        height: 48px;
        margin-right: 5px;
    }

    main {
        width: 960px;
    }

    main h3 span {
        text-shadow: 3px 3px 10px black;
    }

    ul {
        list-style-type: none;
    }

    li {
        margin-bottom: 48px;
    }

    li * {
        text-decoration: none;
        transition: 0.2s ease;
    }

    ul, li {
        margin-top: 0px;
    }

    ul li {
        text-decoration: none;
        transition: 0.2s ease;
    }

    ul li a {
        display: block;
    }

    h3 {
        margin-top: 1.5rem;
    }

    p {
        margin-top: 0px;
        line-height: 2rem;
    }

    #title {
        margin-bottom: 103px;
    }

    .links {
        display: flex;
        justify-content: flex-end;
    }

    .scribble {
        width: auto;
        height: 50px;
    }

    @media (max-width: 40rem) {
        .scribble {
            display: none;
        }
    }

    .project-img {
        display: block;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 10px;
        width: 100%;
        height: 200px;
        object-fit: cover;
        overflow: hidden;
    }	

    .bottom-img {
        margin-left: 50rem;
    }

    .special-box {
        margin: 18px;
    }
</style>
<Card>
    <img class="project-img" src=`${src}` alt=`${alt}` width="100" height="200" />
    <h3>{name}</h3>
    <p>
        <slot />
    </p>
    <div class="links">
        <img class="scribble" src="/scribbles/ProjectLinks.png" alt="Check out the project" />
        {
            itch ? 
                <a href=`${itch}` target="_blank" rel="noopener noreferrer">
                    <Icon name="cib:itch-io" />
                </a> 
            : null
        }
        {
            website ? 
                <a href=`${website}` target="_blank" rel="noopener noreferrer">
                    <Icon name="mdi:web" />
                </a> 
            : null 
        }
        {
            github ? 
            <a href=`${github}` target="_blank" rel="noopener noreferrer">
                <Icon name="mdi:github" />
            </a>
            : null
        }
    </div>
</Card>